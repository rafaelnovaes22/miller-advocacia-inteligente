{
  "name": "miller-costa-inteligencia-juridica",
  "version": "1.0.0",
  "description": "Portal Institucional e Triagem com Inteligência Jurídica para Miller Costa Advogados",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/triagem.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
